<pagesize pagetype="Letter" orientation="portrait" width="8.500000" height="11.000000" units="in" page-scale="1.000000"/>
<section footer="0" xid="2" props="page-margin-right:0.929861in; column-line:off; page-margin-left:0.929861in; columns:1; page-margin-top:0.879861in; page-margin-bottom:0.929861in">
<p style="Subtitle" xid="3">Summer activities</p>
<p style="Title" xid="4">Swimming in the lake</p>
<p style="Author" xid="5">Duck</p>
<p xid="6"><image dataid="rId7" xid="7" props="height:1.800000in; width:1.800000in"/></p>
<p style="caption" xid="8">Figure  SEQ Figure \* ARABIC <c props="lang:-none-">1</c>: This is a cute duckling</p>
<p style="heading 1" xid="9">Let’s swim!</p>
<p xid="10">To get started with swimming, first lay down in a water and try not to drown:</p>
<p level="0" listid="1130" parentid="0" style="List Bullet" xid="11" props="text-indent:-18.000000pt; field-font:NULL; margin-left:54.000000pt"><field level="0" listid="1130" parentid="0" style="List Bullet" type="list_label" xid="12" props="text-indent:-18.000000pt; field-font:NULL; margin-left:54.000000pt"></field><c level="0" listid="1130" parentid="0" style="List Bullet" type="list_label" props="text-indent:-18.000000pt; field-font:NULL; margin-left:54.000000pt">	You can relax and look around</c></p>
<p level="0" listid="1130" parentid="0" style="List Bullet" xid="13" props="text-indent:-18.000000pt; field-font:NULL; margin-left:54.000000pt"><field level="0" listid="1130" parentid="0" style="List Bullet" type="list_label" xid="14" props="text-indent:-18.000000pt; field-font:NULL; margin-left:54.000000pt"></field><c level="0" listid="1130" parentid="0" style="List Bullet" type="list_label" props="text-indent:-18.000000pt; field-font:NULL; margin-left:54.000000pt">	Paddle about</c></p>
<p level="0" listid="1130" parentid="0" style="List Bullet" xid="15" props="text-indent:-18.000000pt; field-font:NULL; margin-left:54.000000pt"><field level="0" listid="1130" parentid="0" style="List Bullet" type="list_label" xid="16" props="text-indent:-18.000000pt; field-font:NULL; margin-left:54.000000pt"></field><c level="0" listid="1130" parentid="0" style="List Bullet" type="list_label" props="text-indent:-18.000000pt; field-font:NULL; margin-left:54.000000pt">	Enjoy summer warmth</c></p>
<p style="List Bullet" level="0" xid="17"><c level="0" listid="1130" parentid="0" style="List Bullet" type="list_label" props="text-indent:-18.000000pt; field-font:NULL; margin-left:54.000000pt">Also, don’t forget:</c></p>
<p level="0" listid="1100" parentid="0" style="List Bullet" xid="18" props="text-indent:-18.000000pt; margin-left:54.000000pt"><field level="0" listid="1100" parentid="0" style="List Bullet" type="list_label" xid="19" props="text-indent:-18.000000pt; margin-left:54.000000pt"></field><c level="0" listid="1100" parentid="0" style="List Bullet" type="list_label" props="text-indent:-18.000000pt; margin-left:54.000000pt">	Wear sunglasses</c></p>
<p level="0" listid="1100" parentid="0" style="List Bullet" xid="20" props="text-indent:-18.000000pt; margin-left:54.000000pt"><field level="0" listid="1100" parentid="0" style="List Bullet" type="list_label" xid="21" props="text-indent:-18.000000pt; margin-left:54.000000pt"></field><c level="0" listid="1100" parentid="0" style="List Bullet" type="list_label" props="text-indent:-18.000000pt; margin-left:54.000000pt">	Don’t forget to drink water</c></p>
<p level="0" listid="1100" parentid="0" style="List Bullet" xid="22" props="text-indent:-18.000000pt; margin-left:54.000000pt"><field level="0" listid="1100" parentid="0" style="List Bullet" type="list_label" xid="23" props="text-indent:-18.000000pt; margin-left:54.000000pt"></field><c level="0" listid="1100" parentid="0" style="List Bullet" type="list_label" props="text-indent:-18.000000pt; margin-left:54.000000pt">	Use sun cream</c></p>
<p style="List Bullet" level="0" xid="24"><c level="0" listid="1100" parentid="0" style="List Bullet" type="list_label" props="text-indent:-18.000000pt; margin-left:54.000000pt">Hmm, what else…</c></p>
<p style="heading 2" xid="25"><c level="0" listid="1100" parentid="0" style="List Bullet" type="list_label" props="text-indent:-18.000000pt; margin-left:54.000000pt">Let’s eat</c></p>
<p xid="26"><c level="0" listid="1100" parentid="0" style="List Bullet" type="list_label" props="text-indent:-18.000000pt; margin-left:54.000000pt">After we had a good day of swimming in the lake, it’s important to eat something nice</c></p>
<p style="Quote" xid="27"><c level="0" listid="1100" parentid="0" style="List Bullet" type="list_label" props="text-indent:-18.000000pt; margin-left:54.000000pt">I like to eat leaves</c></p>
<p xid="28"><c level="0" listid="1100" parentid="0" style="List Bullet" type="list_label" props="text-indent:-18.000000pt; margin-left:54.000000pt">Here are some interesting things a respectful duck could eat:</c></p>
<table xid="29" props="top-style:1; bot-style:1; bot-color:000000; table-column-props:159.350000pt/159.350000pt/159.400000pt/; margin-left:18.700000pt; margin-bottom:0.000000pt; right-style:1; line-height:1.000000; left-style:1; bot-thickness:3.000000pt">
<cell xid="30" props="bot-style:1; margin-left:18.700000pt; bot-thickness:3.000000pt; right-attach:1; top-attach:0; right-style:1; left-attach:0; left-style:1; margin-bottom:0.000000pt; table-column-props:159.350000pt/159.350000pt/159.400000pt/; bot-color:000000; line-height:1.000000; bot-attach:1; top-style:1">
<p xid="31"><c level="0" listid="1100" parentid="0" style="List Bullet" type="list_label" props="text-indent:-18.000000pt; margin-left:54.000000pt"></c></p>
</cell>
<cell xid="32" props="bot-style:1; margin-left:18.700000pt; bot-thickness:3.000000pt; right-attach:2; top-attach:0; right-style:1; left-attach:1; left-style:1; margin-bottom:0.000000pt; table-column-props:159.350000pt/159.350000pt/159.400000pt/; bot-color:000000; line-height:1.000000; bot-attach:1; top-style:1">
<p xid="33"><c level="0" listid="1100" parentid="0" style="List Bullet" type="list_label" props="text-indent:-18.000000pt; margin-left:54.000000pt">Food</c></p>
</cell>
<cell xid="34" props="bot-style:1; margin-left:18.700000pt; bot-thickness:3.000000pt; right-attach:3; top-attach:0; right-style:1; left-attach:2; left-style:1; margin-bottom:0.000000pt; table-column-props:159.350000pt/159.350000pt/159.400000pt/; bot-color:000000; line-height:1.000000; bot-attach:1; top-style:1">
<p xid="35"><c level="0" listid="1100" parentid="0" style="List Bullet" type="list_label" props="text-indent:-18.000000pt; margin-left:54.000000pt">Calories per portion</c></p>
</cell>
<cell xid="36" props="bot-style:1; margin-left:18.700000pt; bot-thickness:3.000000pt; right-attach:1; top-attach:1; right-style:1; left-attach:0; left-style:1; margin-bottom:0.000000pt; table-column-props:159.350000pt/159.350000pt/159.400000pt/; bot-color:000000; line-height:1.000000; bot-attach:2; top-style:1">
<p xid="37"><c level="0" listid="1100" parentid="0" style="List Bullet" type="list_label" props="text-indent:-18.000000pt; margin-left:54.000000pt">Leaves</c></p>
</cell>
<cell xid="38" props="bot-style:1; margin-left:18.700000pt; bot-thickness:3.000000pt; right-attach:2; top-attach:1; right-style:1; left-attach:1; left-style:1; margin-bottom:0.000000pt; table-column-props:159.350000pt/159.350000pt/159.400000pt/; bot-color:000000; line-height:1.000000; bot-attach:2; top-style:1">
<p xid="39"><c level="0" listid="1100" parentid="0" style="List Bullet" type="list_label" props="text-indent:-18.000000pt; margin-left:54.000000pt">Ash, Elm, Maple</c></p>
</cell>
<cell xid="40" props="bot-style:1; margin-left:18.700000pt; bot-thickness:3.000000pt; right-attach:3; top-attach:1; right-style:1; left-attach:2; left-style:1; margin-bottom:0.000000pt; table-column-props:159.350000pt/159.350000pt/159.400000pt/; bot-color:000000; line-height:1.000000; bot-attach:2; top-style:1">
<p xid="41"><c level="0" listid="1100" parentid="0" style="List Bullet" type="list_label" props="text-indent:-18.000000pt; margin-left:54.000000pt">50</c></p>
</cell>
<cell xid="42" props="bot-style:1; margin-left:18.700000pt; bot-thickness:3.000000pt; right-attach:1; top-attach:2; right-style:1; left-attach:0; left-style:1; margin-bottom:0.000000pt; table-column-props:159.350000pt/159.350000pt/159.400000pt/; bot-color:000000; line-height:1.000000; bot-attach:3; top-style:1">
<p xid="43"><c level="0" listid="1100" parentid="0" style="List Bullet" type="list_label" props="text-indent:-18.000000pt; margin-left:54.000000pt">Berries</c></p>
</cell>
<cell xid="44" props="bot-style:1; margin-left:18.700000pt; bot-thickness:3.000000pt; right-attach:2; top-attach:2; right-style:1; left-attach:1; left-style:1; margin-bottom:0.000000pt; table-column-props:159.350000pt/159.350000pt/159.400000pt/; bot-color:000000; line-height:1.000000; bot-attach:3; top-style:1">
<p xid="45"><c level="0" listid="1100" parentid="0" style="List Bullet" type="list_label" props="text-indent:-18.000000pt; margin-left:54.000000pt">Blueberry, Strawberry, Cranberry</c></p>
</cell>
<cell xid="46" props="bot-style:1; margin-left:18.700000pt; bot-thickness:3.000000pt; right-attach:3; top-attach:2; right-style:1; left-attach:2; left-style:1; margin-bottom:0.000000pt; table-column-props:159.350000pt/159.350000pt/159.400000pt/; bot-color:000000; line-height:1.000000; bot-attach:3; top-style:1">
<p xid="47"><c level="0" listid="1100" parentid="0" style="List Bullet" type="list_label" props="text-indent:-18.000000pt; margin-left:54.000000pt">150</c></p>
</cell>
<cell xid="48" props="bot-style:1; margin-left:18.700000pt; bot-thickness:3.000000pt; right-attach:1; top-attach:3; right-style:1; left-attach:0; left-style:1; margin-bottom:0.000000pt; table-column-props:159.350000pt/159.350000pt/159.400000pt/; bot-color:000000; line-height:1.000000; bot-attach:4; top-style:1">
<p xid="49"><c level="0" listid="1100" parentid="0" style="List Bullet" type="list_label" props="text-indent:-18.000000pt; margin-left:54.000000pt">Grain</c></p>
</cell>
<cell xid="50" props="bot-style:1; margin-left:18.700000pt; bot-thickness:3.000000pt; right-attach:2; top-attach:3; right-style:1; left-attach:1; left-style:1; margin-bottom:0.000000pt; table-column-props:159.350000pt/159.350000pt/159.400000pt/; bot-color:000000; line-height:1.000000; bot-attach:4; top-style:1">
<p xid="51"><c level="0" listid="1100" parentid="0" style="List Bullet" type="list_label" props="text-indent:-18.000000pt; margin-left:54.000000pt">Corn, Buckwheat, Barley</c></p>
</cell>
<cell xid="52" props="bot-style:1; margin-left:18.700000pt; bot-thickness:3.000000pt; right-attach:3; top-attach:3; right-style:1; left-attach:2; left-style:1; margin-bottom:0.000000pt; table-column-props:159.350000pt/159.350000pt/159.400000pt/; bot-color:000000; line-height:1.000000; bot-attach:4; top-style:1">
<p xid="53"><c level="0" listid="1100" parentid="0" style="List Bullet" type="list_label" props="text-indent:-18.000000pt; margin-left:54.000000pt">200</c></p>
</cell>
</table>
<p xid="54"><c level="0" listid="1100" parentid="0" style="List Bullet" type="list_label" props="text-indent:-18.000000pt; margin-left:54.000000pt"></c></p>
<p xid="55"><c level="0" listid="1100" parentid="0" style="List Bullet" type="list_label" props="text-indent:-18.000000pt; margin-left:54.000000pt">And let’s add another list in the end:</c></p>
<p level="0" listid="1190" parentid="0" style="List Paragraph" xid="56" props="text-indent:-18.000000pt; margin-left:36.000000pt"><field level="0" listid="1190" parentid="0" style="List Paragraph" type="list_label" xid="57" props="text-indent:-18.000000pt; margin-left:36.000000pt"></field><c level="0" listid="1190" parentid="0" style="List Paragraph" type="list_label" props="text-indent:-18.000000pt; margin-left:36.000000pt">	Leaves</c></p>
<p level="0" listid="1190" parentid="0" style="List Paragraph" xid="58" props="text-indent:-18.000000pt; margin-left:36.000000pt"><field level="0" listid="1190" parentid="0" style="List Paragraph" type="list_label" xid="59" props="text-indent:-18.000000pt; margin-left:36.000000pt"></field><c level="0" listid="1190" parentid="0" style="List Paragraph" type="list_label" props="text-indent:-18.000000pt; margin-left:36.000000pt">	Berries</c></p>
<p level="0" listid="1190" parentid="0" style="List Paragraph" xid="60" props="text-indent:-18.000000pt; margin-left:36.000000pt"><field level="0" listid="1190" parentid="0" style="List Paragraph" type="list_label" xid="61" props="text-indent:-18.000000pt; margin-left:36.000000pt"></field><c level="0" listid="1190" parentid="0" style="List Paragraph" type="list_label" props="text-indent:-18.000000pt; margin-left:36.000000pt">	Grain</c></p>
</section>
